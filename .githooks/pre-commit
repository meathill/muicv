#!/bin/sh
# pre-commit：对本仓库「已暂存的源码文件」跑 biome（format + 安全自动修复），
# 然后把修复结果重新加入暂存区，保证提交下去的内容永远是 biome 规整过的。
#
# 为什么只跑暂存文件：全仓要扫 500+ 文件，每次提交都做太慢；只处理本次改动即可，
# 未改动的文件在各自引入时已被规整过。
#
# 为什么「阻断提交」：2026-10-24 已把全部 lint 存量清零（原 127+ 处历史遗留，
# 见 DEV_NOTE.md biome 小节），新引入的违规应该当场修掉，而不是流进仓库。
# 修复不了时用 git commit --no-verify 绕过，并在提交说明里说明原因。
#
# 安装：pnpm install 时由 package.json 的 prepare 脚本设置 core.hooksPath=.githooks。
# 手工安装：git config core.hooksPath .githooks

set -u

# 用 -z（NUL 分隔）安全处理含空格 / 括号 / 方括号的路径，例如
# app/(zh)/r/render/[token]/。pathspec 在每个命令里内联重复，因为 POSIX sh 没有数组。
staged=$(git diff --cached --name-only --diff-filter=ACM -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.css')
if [ -z "$staged" ]; then
  exit 0
fi

printf '%s\n' '[pre-commit] biome check --write（已暂存的源码文件）'

git diff --cached --name-only --diff-filter=ACM -z -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.css' \
  | xargs -0 npx biome check --write
biome_status=$?

# biome 改过的文件重新入暂存区（未变化的文件重复 add 无副作用）。
git diff --cached --name-only --diff-filter=ACM -z -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.css' \
  | xargs -0 git add --

if [ "$biome_status" -ne 0 ]; then
  printf '\n%s\n' '[pre-commit] 暂存文件存在 biome 修不掉的违规（lint / 格式冲突），提交已阻断。'
  printf '%s\n' '             逐条修掉后重试；确需绕过：git commit --no-verify'
  exit 1
fi

exit 0
