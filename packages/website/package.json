{
  "name": "@muicv/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mui简历 web app：landing page (muicv.com) 和将来的 dashboard。Next.js + OpenNext on Cloudflare Worker。",
  "scripts": {
    "dev": "next dev -p 3070",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:migrate:local": "wrangler d1 migrations apply muicv --local",
    "db:migrate": "wrangler d1 migrations apply muicv --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@muicv/shared": "workspace:*",
    "@muicv/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
