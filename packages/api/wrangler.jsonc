{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muicv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "routes": [
    {
      "pattern": "api.muicv.com/*",
      "zone_name": "muicv.com"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  // 统一岗位搜索的向量索引，采集（scheduled，src/cron）与搜索共用（创建命令见 DEPLOYMENT.md）。
  // 岗位采集（UTC）：每 6 小时跑雇主 ATS + Remotive；每天 2 次（北京时间 08:00 / 20:00）跑垂直岗位板
  // 第二个表达式必须与 src/cron/index.ts 的 NICHE_CRON 一致
  "triggers": {
    "crons": ["17 */6 * * *", "0 0,12 * * *"]
  },
  "vectorize": [
    {
      "binding": "JOBS_INDEX",
      "index_name": "muicv-jobs"
    }
  ],
  // /jobs/search 速率限制：带 key 按 userId，匿名按 IP。namespace_id 是账户内自定义整数。
  "ratelimits": [
    {
      "name": "JOBS_SEARCH_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "JOBS_SEARCH_ANON_LIMITER",
      "namespace_id": "1102",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // BrowserContainer 已下线；v1/v2 migration 必须留着，否则 Cloudflare 会拒部署。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BrowserContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["BrowserContainer"]
    }
  ],
  // KV / D1 与 packages/website 共用同一份资源（id 必须保持一致）。
  "kv_namespaces": [
    {
      "binding": "MUICV_KV",
      "id": "3db8f70ff2494a798b06ba699adc6d5a"
    }
  ],
  "d1_databases": [
    {
      "binding": "MUICV_API_DB",
      "database_name": "muicv",
      "database_id": "db60cfbd-48e1-4220-9239-18c117f26ed0",
      "migrations_dir": "migrations"
    }
  ],
  // 简历素材加密同步 blob，公开域名 i.muicv.com（按需开启 access policy）。
  // MUICV_PHOTOS：在线预览 / PDF 用的证件照，公开读取（puppeteer 要能 fetch 到外链）。
  "r2_buckets": [
    {
      "binding": "MUICV_RESUME_BLOB",
      "bucket_name": "muicv"
    },
    {
      "binding": "MUICV_PHOTOS",
      "bucket_name": "muicv"
    }
  ],
  // Readability / turndown 在 puppeteer page 内 addScriptTag，作为文本资源 import。
  "rules": [
    {
      "type": "Text",
      "globs": ["**/Readability.js", "**/turndown.js"],
      "fallthrough": true
    }
  ],
  "vars": {
    "RENDER_BASE_URL": "https://muicv.com",
    "PHOTOS_PUBLIC_BASE_URL": "https://i.muicv.com",
    "PREVIEW_PUBLIC_BASE_URL": "https://muicv.com",
    "MUICV_CMS_URL": "https://cms.muicv.com",
    // 岗位采集（scheduled）：见 src/cron。JOBS_SUBREQUEST_BUDGET 按计划设（Paid 1000 / Free 50）
    "JOBS_MAX_AGE_DAYS": "30",
    "JOBS_MAX_NEW_PER_RUN": "150",
    "JOBS_LOCATION_LLM": "on",
    "JOBS_SUBREQUEST_BUDGET": "900"
    // Stripe priceId → plan 的反查表已下沉到 @muicv/shared（src/stripe-prices.ts），
    // 与 packages/website 共用同一份，不再放 env vars（历史上两边 ID 代际不同步，
    // 导致 Pro 订阅在桌面 app 显示为免费版）。
  },
  "observability": {
    "enabled": false
  },
  "placement": {
    "mode": "smart"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "MIMO_API_KEY", "HSM_SECRET"]
  }
}
